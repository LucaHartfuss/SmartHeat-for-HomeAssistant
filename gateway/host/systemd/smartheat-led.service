[Unit]
Description=SmartHeat-Gateway LED (G2 8.5)
After=multi-user.target

[Service]
Environment=PYTHONPATH=/opt/smartheat/host
Environment=SHG_ROOT=@ROOT@
ExecStart=/usr/bin/python3 -m smartheat_host.led
Restart=always
RestartSec=30
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=@ROOT@

[Install]
WantedBy=multi-user.target
