[Unit]
Description=SmartHeat-Gateway Updater (Spec SHG G2b-1 4)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Environment=PYTHONPATH=/opt/smartheat/host
Environment=SHG_ROOT=@ROOT@
EnvironmentFile=@ROOT@/host/gateway.env
ExecStart=/usr/bin/python3 -m smartheat_host.updater
Restart=always
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@ROOT@ /run/docker.sock

[Install]
WantedBy=multi-user.target
