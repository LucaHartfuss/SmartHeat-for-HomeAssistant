[Unit]
Description=SmartHeat-Gateway Updater (Spec SHG G2b-1 4)
# Wartet nur auf Docker, das Netz und die Ablage, nie auf smartheat-firstboot (Laden der Archive): nach einem Systemwechsel
# laeuft die lokale Gesundheitsfrist ab dem Start des Updaters, der Frist-Timer schaltet 20 min nach dem Boot zurueck.
After=network-online.target docker.service smartheat-ablage.service
Wants=network-online.target
Requires=docker.service smartheat-ablage.service
RequiresMountsFor=@ROOT@

[Service]
Environment=PYTHONPATH=/opt/smartheat/host
EnvironmentFile=/opt/smartheat/gateway.env
ExecStart=/usr/bin/python3 -m smartheat_host.updater
Restart=always
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@ROOT@ /run/docker.sock

[Install]
WantedBy=multi-user.target
