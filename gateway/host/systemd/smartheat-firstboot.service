[Unit]
Description=SmartHeat-Gateway Start: Container-Archive des Images laden (je Archiv einmal), laufendes Bundle starten (GPC31)
After=docker.service smartheat-ablage.service
Requires=docker.service smartheat-ablage.service
RequiresMountsFor=@ROOT@
# Bewusst kein Before= auf irgendeine Unit: das Laden der Archive dauert Minuten, der Updater (Probestart-Frist, GW 6.3)
# darf nicht dahinter warten.

[Service]
Type=oneshot
Environment=PYTHONPATH=/opt/smartheat/host
EnvironmentFile=/opt/smartheat/gateway.env
ExecStart=/usr/bin/python3 -m smartheat_host.firstboot start
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@ROOT@ /run/docker.sock

[Install]
WantedBy=multi-user.target
