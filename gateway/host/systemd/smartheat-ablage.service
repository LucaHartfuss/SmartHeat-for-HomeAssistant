[Unit]
Description=SmartHeat-Gateway Ablage: Ordner, Besitzer und Modi unter @ROOT@ angleichen, beim ersten Start das erste Bundle anlegen (GPC31)
# Schnell und rein lokal (Sekunden): Updater und Hoststatus warten nur hierauf, nicht auf das Laden der Container-Archive
# (smartheat-firstboot, dauert Minuten). Der Updater muss nach dem Probestart spaetestens etwa 7 min nach dem Boot laufen.
RequiresMountsFor=@ROOT@

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PYTHONPATH=/opt/smartheat/host
EnvironmentFile=/opt/smartheat/gateway.env
ExecStart=/usr/bin/python3 -m smartheat_host.firstboot ablage
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@ROOT@

[Install]
WantedBy=multi-user.target
