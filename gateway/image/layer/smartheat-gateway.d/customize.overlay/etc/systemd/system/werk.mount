[Unit]
Description=SmartHeat-Gateway Werkspartition (nur lesend)
# Kein Teil von local-fs.target: fehlt die Partition oder ist sie beschaedigt, startet das System trotzdem
# (smartheat-werk.service meldet dann keine gueltige Werksdatei, Anmeldung nicht moeglich).

[Mount]
What=/dev/disk/by-partlabel/werk
Where=/werk
Type=ext4
Options=ro,nodev,nosuid,noexec,noatime

[Install]
WantedBy=multi-user.target
